{
  "name": "product-manage-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server.js --dev",
    "test": "node --test web/src/catalogView.test.js src/productInput.test.js web/src/productImage.test.js src/qa-scenarios.test.js",
    "build:web": "npm run build --prefix web",
    "start": "npm run build:web && node server.js",
    "dev:worker": "scripts\\with-node.cmd wrangler dev",
    "preview": "scripts\\with-node.cmd npm run build:web && wrangler preview",
    "deploy": "scripts\\with-node.cmd npm run build:web && wrangler deploy",
    "workflow:verify": "node scripts/workflow-check.mjs verify",
    "workflow:ready": "node scripts/workflow-check.mjs ready",
    "memory:verify": "node scripts/workflow-check.mjs verify memory",
    "memory:ready": "node scripts/workflow-check.mjs ready memory"
  },
  "dependencies": {
    "express": "^4.21.2",
    "mongodb": "^6.18.0"
  },
  "devDependencies": {
    "vite": "^7.1.5",
    "wrangler": "^4.86.0"
  }
}
