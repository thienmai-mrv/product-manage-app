# Local Express only. Copy this file to .env and set the Atlas connection string.
# Do not commit .env. Production uses the Worker secret named MONGODB_URI.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=productmanage
# SESSION_SECRET must be at least 32 characters.
# Set AUTH_BOOTSTRAP_USERNAME, AUTH_BOOTSTRAP_EMAIL, and AUTH_BOOTSTRAP_PASSWORD together for the first admin.
SESSION_SECRET=
AUTH_BOOTSTRAP_USERNAME=
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_PASSWORD=
